# PreviewのUpstash連携でCustom Prefixを指定した場合は、この組を最優先で使います。
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Custom PrefixなしのUpstash統合では、この標準名を使います。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 既存のVercel KV互換名を使う場合はこちら（上の空欄はそのままでも動作します）。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
